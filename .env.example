# API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
GOOGLE_SEARCH_API_KEY=xxxxxxxxxxxxx
GOOGLE_SEARCH_ENGINE_ID=xxxxxxxxxxxxx

# Gmail Configuration (OAuth2)
GMAIL_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxxxxxxx
GMAIL_REDIRECT_URI=http://localhost:8080/auth/callback
GMAIL_TOKEN_PATH=./email/token.json
GMAIL_CREDENTIALS_PATH=./email/credentials.json

# Scraping Configuration
LINKEDIN_EMAIL=your.email@example.com
LINKEDIN_PASSWORD=your_password
INTERNSHALA_API_KEY=xxxxxxxxxxxxx

# Database
DB_PATH=./db/applications.db

# Application Settings
LOG_LEVEL=INFO
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Flask UI
FLASK_ENV=development
FLASK_PORT=5000
DEBUG=True

# Email Settings
FROM_EMAIL=your.email@example.com
EMAIL_TEMPLATE_PATH=./email/templates/
