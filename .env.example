# ── LLM & AI GATEWAY ──────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Backup LLM (free - aistudio.google.com)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# ── WEB RESEARCH / SCRAPING ───────────────────────────────
# Tavily - for smart job search queries (app.tavily.com)
TAVILY_API_KEY=tvly_xxxxxxxxxxxxx

# ScrapingBee - for portals that block Playwright (scrapingbee.com)
# 1000 free credits, no card needed
SCRAPINGBEE_API_KEY=xxxxxxxxxxxxx

# Google Custom Search - optional 100 queries/day free
# console.cloud.google.com -> Custom Search API
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── EMAIL ────────────────────────────────────────────────
FROM_EMAIL=your.email@gmail.com
FROM_NAME=Your Full Name
GMAIL_CREDENTIALS_PATH=./email_module/credentials.json
GMAIL_TOKEN_PATH=./email_module/token.json

# How many emails max per pipeline run (safety cap)
MAX_EMAILS_PER_RUN=10

# ── DATABASE ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Isolated disposable test database (NEVER set to production DATABASE_URL).
# Integration tests refuse to run if this is missing or points to production.
# Example for Neon: create a separate database `applyr_test` on same host:
#   CREATE DATABASE applyr_test
# Then: postgresql://user:pass@host:5432/applyr_test?sslmode=require
TEST_DATABASE_URL=postgresql://user:pass@host:5432/applyr_test?sslmode=require

# ── RESUME & PROFILE ─────────────────────────────────────
PROFILE_PATH=./profile.json
MASTER_RESUME_PDF=./resume/master_resume.pdf
MASTER_RESUME_DOCX=./resume/master_resume.docx
TAILORED_RESUME_DIR=./resume/tailored/
COVER_LETTER_DIR=./resume/cover_letters/

# ── UPLOADS (manual trigger) ──────────────────────────────
UPLOAD_DIR=./uploads/
SCREENSHOT_DIR=./autofill/screenshots/

# ── SCHEDULER ────────────────────────────────────────────
# Cron: 9 AM then every 3 hours (9, 12, 15, 18)
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 9,12,15,18 * * *
TIMEZONE=Asia/Kolkata

# ── SCRAPING TARGETS ──────────────────────────────────────
# Comma-separated list of portals to scrape
SCRAPE_SOURCES=linkedin,internshala,naukri,wellfound

# ── SAFETY LAYER ─────────────────────────────────────────
AUTO_APPLY=false
MIN_FIT_SCORE=50
DRY_RUN=true
MAX_APPLICATIONS_PER_DAY=20

# ── PLAYWRIGHT (autofill) ────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=15000

# ── FLASK UI ─────────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5000
DEBUG=true
SECRET_KEY=change_this_to_a_random_string

# ── LOGGING ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs/
MAX_RETRIES=3
REQUEST_TIMEOUT=30
